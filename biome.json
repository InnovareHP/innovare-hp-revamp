{
    "$schema": "https://biomejs.dev/schemas/1.7.0/schema.json",
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 80
    },
    "javascript": {
      "formatter": {
        "semicolons": "always",
        "quoteStyle": "double",
        "trailingCommas": "es5",
        "arrowParentheses": "always",
        "bracketSpacing": true
      }
    },
    "typescript": {
      "formatter": {
        "semicolons": "always",
        "quoteStyle": "double",
        "trailingCommas": "es5",
        "arrowParentheses": "always",
        "bracketSpacing": true
      }
    }
  }
  