// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model LinkedInPost {
  id             String   @id // urn:li:share / ugcPost
  authorUrn      String
  text           String?
  publishedAt    DateTime
  createdAt      DateTime
  lastModifiedAt DateTime
  linkUrl        String?
  raw            Json

  images LinkedInPostImage[]
}

model LinkedInPostImage {
  id       String  @id @default(uuid())
  postId   String
  imageUrn String
  imageUrl String?
  altText  String?
  position Int?

  post LinkedInPost @relation(fields: [postId], references: [id])

  @@unique([postId, imageUrn])
}

model ContactFormSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @db.Timestamptz @default(now())
  updatedAt     DateTime  @db.Timestamptz @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @db.Timestamptz @default(now())
  updatedAt DateTime @db.Timestamptz @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @db.Timestamptz @default(now())
  updatedAt             DateTime  @db.Timestamptz @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @db.Timestamptz @default(now())
  updatedAt  DateTime @db.Timestamptz @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventType {
  ONSITE
  VIRTUAL
}

model Event {
  id String @id @default(uuid())
  slug String @unique

  title String
  description String
  location String
  status EventStatus @default(DRAFT)
  eventType EventType @default(ONSITE)
  qrCode String?

  isPaid               Boolean         @default(false)
  price                Decimal?        @default(0) // Use Decimal for currency
  currency             String          @default("USD")
  hostedBy String?

  eventStartDate DateTime @db.Timestamptz
  eventEndDate DateTime? @db.Timestamptz
  registrationDeadline DateTime? @db.Timestamptz

  createdAt DateTime @db.Timestamptz @default(now())
  updatedAt DateTime @db.Timestamptz @updatedAt

  mediaId String?
  media Media? @relation(fields: [mediaId], references: [id])
  attendees EventAttendee[]
  guests Guest[]
  expectations Expectation[]
}

model Expectation {
  id String @id @default(uuid())
  description String
  createdAt DateTime @db.Timestamptz @default(now())
  updatedAt DateTime @db.Timestamptz @updatedAt

  eventId String
  event Event @relation(fields: [eventId], references: [id])
}

model Guest {
  id String @id @default(uuid())
  name String
  email String
  phone String
  createdAt DateTime @db.Timestamptz @default(now())
  updatedAt DateTime @db.Timestamptz @updatedAt

  eventId String
  event Event @relation(fields: [eventId], references: [id])
}


model EventAttendee {
  id String @id @default(uuid())
  eventId String
  name String
  email String
  phone String

  paymentStatus   PaymentStatus  @default(PENDING)
  stripeSessionId String?        @unique // To verify the payment later
  amountPaid      Decimal?
  note            String?        // Admin note (e.g. refund reason, decline reason)


  event Event @relation(fields: [eventId], references: [id])
  createdAt DateTime @db.Timestamptz @default(now())
  updatedAt DateTime @db.Timestamptz @updatedAt
}


model Media {
  id String @id @default(uuid())
  url String
  type String
  createdAt DateTime @db.Timestamptz @default(now())
  updatedAt DateTime @db.Timestamptz @updatedAt

  events Event[]
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}